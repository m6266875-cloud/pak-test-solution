{
  "name": "pak-test-solution-server",
  "version": "1.0.0",
  "description": "Backend API for Pak Test Solution",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "dev:gateway": "ts-node-dev --transpile-only scripts/dev-gateway.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "db:catalog": "ts-node --transpile-only prisma/catalog/seed.ts",
    "db:catalog:validate": "ts-node --transpile-only prisma/catalog/seed.ts --validate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:migrate:local": "node scripts/apply-migrations.js",
    "test:phase2:questions": "ts-node --transpile-only scripts/phase2-questionbank.test.ts",
    "test:phase2:generator": "ts-node --transpile-only scripts/phase2-generator.test.ts",
    "test:phase2": "npm run test:phase2:questions && npm run test:phase2:generator",
    "test:phase4:units": "ts-node --transpile-only scripts/phase4-candidates.test.ts",
    "test:phase4:wizard": "ts-node --transpile-only scripts/phase4-wizard.test.ts",
    "test:phase4": "npm run test:phase4:units && npm run test:phase4:wizard",
    "db:cleanup": "ts-node --transpile-only scripts/phase4-cleanup.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "puppeteer": "^21.6.1",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "pg": "^8.11.3",
    "@types/pg": "^8.11.5",
    "prisma": "^5.7.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "puppeteer@21.11.0": true
  }
}
