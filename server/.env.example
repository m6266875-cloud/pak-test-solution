# ============================================
# PAK TEST SOLUTION - Environment Configuration
# ============================================

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/pak_test_db"

# JWT Secrets (use strong random strings in production)
JWT_SECRET="change-this-to-a-very-long-random-secret-key-in-production"
JWT_REFRESH_SECRET="change-this-to-another-very-long-random-secret-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=5000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"

# AWS S3 (optional - for PDF storage in production)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="pak-test-papers"

# Redis (optional - for caching/queues)
REDIS_URL="redis://localhost:6379"

# Email (for password reset)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@paktestsolution.com"

# App
APP_NAME="Pak Test Solution"
APP_URL="http://localhost:5000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Super Admin (created on first seed)
SUPER_ADMIN_EMAIL="admin@paktestsolution.com"
SUPER_ADMIN_PASSWORD="Admin@123456"
SUPER_ADMIN_NAME="Super Admin"
